{
  "schema_version": 1,
  "name": "ordinary-worker-v1",
  "default": false,
  "description": "Experimental dedicated ordinary worker pilot. Floors are admission constraints, not observed host capacity or production readiness. VPN peer, offsite backup, worker telemetry, OpsAgent and two isolated coding bindings; MM and coding runtime enrollment are separate gates.",
  "node_role": "worker",
  "deployment_status": "experimental-pilot",
  "min_vcpu": 8,
  "min_ram_mb": 32768,
  "min_disk_gb": 300,
  "gates": { "g1_steady_ratio": 0.75, "g2_cap_ratio": 1.10, "g4_disk_ratio": 1.15, "g5_headroom_mb": 512 },
  "contention_policy": "slices-v1",
  "services": [
    {"id": "observability", "variant": "worker", "steady_mb": 256, "cap_mb": 512, "disk_gb": 5, "adr": "ADR-011", "opts": {}}
  ],
  "platform": [
    {"id": "os-docker", "steady_mb": 614, "cap_mb": 1024, "disk_gb": 25, "opts": {"owner_access": {"admin_login": "root", "sshd": {"permitrootlogin": "prohibit-password", "passwordauthentication": "no", "authenticationmethods": "publickey", "pubkeyauthentication": "yes"}}}},
    {"id": "wireguard", "steady_mb": 31, "cap_mb": 51, "disk_gb": 0, "adr": "ADR-005", "opts": {"role": "peer"}},
    {"id": "backup", "steady_mb": 0, "cap_mb": 819, "disk_gb": 45, "adr": "ADR-008"},
    {"id": "opsagent", "steady_mb": 0, "cap_mb": 2048, "disk_gb": 2, "adr": "ADR-013", "opts": {"interactive_memory_high_mb": 400, "interactive_memory_max_mb": 600, "interactive_concurrent": 1, "chatops_enabled": true, "chatops_memory_max_mb": 1536, "chatops_concurrent": 1}},
    {"id": "coding-runtime", "steady_mb": 8192, "cap_mb": 16384, "disk_gb": 150, "opts": {"binding_count": 2, "max_active_jobs_per_binding": 1, "per_binding_memory_high_mb": 6144, "per_binding_memory_max_mb": 8192}}
  ],
  "slices": {
    "corp-core": {"MemoryLow": "1024M", "MemoryHigh": "infinity", "MemoryMax": "8192M"},
    "corp-ci": {"MemoryLow": "0", "MemoryHigh": "384M", "MemoryMax": "512M"},
    "corp-backup": {"MemoryLow": "0", "MemoryHigh": "600M"},
    "corp-agent": {"MemoryLow": "0", "MemoryHigh": "1600M", "MemoryMax": "2048M"},
    "corp-coding": {"MemoryLow": "0", "MemoryHigh": "12288M", "MemoryMax": "16384M"}
  },
  "offsite": {
    "primary": "yandex-ru",
    "alternatives": ["cloudru"],
    "residency": "RU",
    "storage_class": "hot",
    "retain_logs_offsite": false
  },
  "vpn": {"hub_role": "external", "provider_policy": "generic"}
}
