{
  "schema_version": 1,
  "name": "two-vps-split-b",
  "default": false,
  "description": "Node B of the two-VPS split: public Mattermost and OpenProject, VPN-only wiki and full observability. The corporate site remains external temporarily; GitLab and CI live on node A. Holds the WireGuard admin hub and both Caddy instances.",
  "node_role": "apps",
  "min_vcpu": 4,
  "min_ram_mb": 15360,
  "min_disk_gb": 210,
  "gates": { "g1_steady_ratio": 0.75, "g2_cap_ratio": 1.10, "g4_disk_ratio": 1.15, "g5_headroom_mb": 512 },
  "contention_policy": "slices-v1",
  "services": [
    {"id": "tracker", "variant": "openproject", "steady_mb": 4096, "cap_mb": 5120, "disk_gb": 30, "adr": "ADR-009", "opts": {"exposure": "public", "hostname": "projects"}},
    {"id": "mattermost", "variant": "team-edition", "steady_mb": 2048, "cap_mb": 4096, "disk_gb": 20, "adr": "ADR-014", "opts": {"exposure": "public", "hostname": "chat"}},
    {"id": "wiki", "variant": "bookstack", "steady_mb": 819, "cap_mb": 1024, "disk_gb": 10, "adr": "ADR-010"},
    {"id": "site", "variant": "external", "steady_mb": 0, "cap_mb": 0, "disk_gb": 0, "adr": "ADR-010"},
    {"id": "observability", "variant": "full", "steady_mb": 1536, "cap_mb": 2560, "disk_gb": 45, "adr": "ADR-011", "opts": {"prom_retention": "90d", "prom_retention_size": "25GB", "loki_retention": "720h", "blackbox": true, "scrapes_both_nodes": true}}
  ],
  "platform": [
    {"id": "os-docker", "steady_mb": 614, "cap_mb": 1024, "disk_gb": 25},
    {"id": "wireguard", "steady_mb": 31, "cap_mb": 51, "disk_gb": 0, "adr": "ADR-005", "opts": {"role": "server", "address": "10.8.0.1"}},
    {"id": "caddy", "steady_mb": 102, "cap_mb": 154, "disk_gb": 2, "adr": "ADR-006", "opts": {"instances": ["public", "internal"]}},
    {"id": "backup", "steady_mb": 0, "cap_mb": 819, "disk_gb": 45, "adr": "ADR-008"},
    {"id": "opsagent", "steady_mb": 0, "cap_mb": 2048, "disk_gb": 2, "adr": "ADR-013", "opts": {"interactive_memory_high_mb": 400, "interactive_memory_max_mb": 600, "interactive_concurrent": 1, "chatops_enabled": true, "chatops_memory_max_mb": 1536, "chatops_concurrent": 1}}
  ],
  "slices": {
    "corp-core": {"MemoryLow": "9246M", "MemoryHigh": "infinity", "MemoryMax": "14029M"},
    "corp-ci": {"MemoryLow": "0", "MemoryHigh": "1.2G", "MemoryMax": "1.5G"},
    "corp-backup": {"MemoryLow": "0", "MemoryHigh": "600M", "MemoryMax": "800M"},
    "corp-agent": {"MemoryLow": "0", "MemoryHigh": "1600M", "MemoryMax": "2048M"}
  },
  "offsite": {
    "primary": "yandex-ru",
    "alternatives": ["cloudru"],
    "residency": "RU",
    "storage_class": "hot",
    "retain_logs_offsite": false
  },
  "vpn": { "hub_role": "self", "provider_policy": "adminvps-eu" }
}
