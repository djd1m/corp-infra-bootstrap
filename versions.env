# corp-infra version pins - the lock file of the repo set (ADR-012 section 4).
#
# Filled in and cross-checked in Phase C (task T-C1). bootstrap.sh reads this
# file to decide which tag of each repository to check out, and records the
# result in /var/lib/corp-infra/state.json under "repos".
#
# Rule: the value here must equal the repository's own lib/VERSION header and
# the version stated in its README. Gate G-09 compares them.

CORP_INFRA_LIB_VERSION=1.0.1
CORP_INFRA_BOOTSTRAP_VERSION=1.0.0
CORP_INFRA_SECURITY_VERSION=1.0.0
CORP_INFRA_VPN_PROXY_VERSION=1.0.0
CORP_INFRA_BACKUP_VERSION=1.0.0
CORP_INFRA_ENT_INFRA_VERSION=1.0.0
CORP_INFRA_POP_AGENTS_VERSION=1.0.0

# GitHub organisation that hosts the six corp-infra-* repositories.
# Until this is set to a real value, bootstrap.sh skips the checkout step and
# expects the repositories to be present under /opt/corp-infra already.
CORP_INFRA_GITHUB_ORG="<org>"
